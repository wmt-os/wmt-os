CONFIG_LOCALVERSION="-wm8505"
# CONFIG_LOCALVERSION_AUTO is not set

# Loadable Module Support
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_SIG is not set

# System Type
# CONFIG_ARCH_MULTI_V6 is not set
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_WM8505=y

# Kernel Features
CONFIG_AEABI=y
# CONFIG_PERF_EVENTS is not set
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_PSI is not set

# Boot Options
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_CMDLINE="usbcore.autosuspend=-1"
CONFIG_CMDLINE_EXTEND=y

# Power Management
CONFIG_CPU_IDLE=y
# CONFIG_HIBERNATION is not set

# Memory Management
CONFIG_SLUB_TINY=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
# CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZO is not set

# MTD Support
CONFIG_MTD=y
CONFIG_MTD_WMT_SFLASH=y

# Network Device Support
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_VIA_VELOCITY=y

# Input Device Support
CONFIG_SERIO=y
CONFIG_SERIO_WM8505_KBDC=y

# Serial Drivers
CONFIG_SERIAL_VT8500=y
CONFIG_SERIAL_VT8500_CONSOLE=y

# I2C Support
CONFIG_I2C=y
CONFIG_I2C_WMT=y

# Pinctrl Support
CONFIG_PINCTRL_WM8505=y

# Common Clock Framework
# CONFIG_COMMON_CLK_VT8500 is not set

# PWM Support
CONFIG_PWM=y
CONFIG_PWM_VT8500=y

# Graphics Support
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_WMT=y

# Sound Support
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_WMT=y
CONFIG_SND_SOC_WM8505_AC97=y

# USB Support
CONFIG_USB=y
# CONFIG_USB_DWC2 is not set
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
# CONFIG_USB_OTG is not set
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_UHCI_PLATFORM=y

# MMC/SD/SDIO Card Support
CONFIG_MMC=y
CONFIG_MMC_WMT=y

# Real Time Clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_VT8500=y

# DMA Engine support
CONFIG_WMT_DMA=y

# File Systems
CONFIG_EXT4_FS=y

# Security Options
# CONFIG_AUDIT is not set
# CONFIG_INTEGRITY is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_LANDLOCK is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set

# Cryptographic API
CONFIG_CRYPTO_LZ4=y

# Kernel Hacking
# CONFIG_KFENCE is not set
# CONFIG_PROFILING is not set
