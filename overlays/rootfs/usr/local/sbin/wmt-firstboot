#!/bin/sh
# Apply /boot/uboot/setup.ini on first boot, with sane fallbacks. Runs once
# (ConditionFirstBoot); best-effort, so a failing step never blocks the rest.

hostname=wm8505
rootpw=root
timezone=UTC
username=wmtuser
userpw=wmtuser

ini=/boot/uboot/setup.ini
if [ -f "$ini" ]; then
	val() { awk -F= -v k="$1" '$1==k { sub(/^[^=]*=/, ""); sub(/\r$/, ""); print; exit }' "$ini"; }
	x=$(val Hostname);     [ -n "$x" ] && hostname=$x
	x=$(val RootPassword); [ -n "$x" ] && rootpw=$x
	x=$(val Timezone);     [ -n "$x" ] && timezone=$x
	x=$(val UserName);     [ -n "$x" ] && username=$x
	x=$(val UserPassword); [ -n "$x" ] && userpw=$x
	rm -f "$ini"   # holds plaintext passwords
fi

echo "$hostname" > /etc/hostname
hostname "$hostname"
sed -i "2i 127.0.1.1\t$hostname" /etc/hosts

[ -e "/usr/share/zoneinfo/$timezone" ] || timezone=UTC
ln -sf "/usr/share/zoneinfo/$timezone" /etc/localtime
echo "$timezone" > /etc/timezone

echo "root:$rootpw" | chpasswd

adduser --disabled-password --gecos "" "$username"
adduser "$username" sudo
echo "$username:$userpw" | chpasswd

for t in rsa ecdsa ed25519; do
	key="/etc/dropbear/dropbear_${t}_host_key"
	[ -f "$key" ] || dropbearkey -t "$t" -f "$key" >/dev/null 2>&1
done

growpart /dev/mmcblk0 2 || true
resize2fs /dev/mmcblk0p2 || true

sync
