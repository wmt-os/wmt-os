#!/bin/sh
# Build the WM8505 boot slot (uzImage.bin + scriptcmd) for a kernel and rotate the
# previous slot to the rollback slot. Arg 1: version (default: newest installed).
set -e

boot=/boot/uboot
template=/usr/share/wmt-boot/uboot.cmd

# On a booted device the FAT must be mounted; in the build chroot it's a plain dir
# (no systemd), so skip the check there rather than write to the rootfs underlay.
if [ -d /run/systemd/system ] && ! mountpoint -q "$boot"; then
	echo "wmt-deploy-boot: $boot is not mounted; refusing to write the boot slot" >&2
	exit 1
fi

# Defer if mkimage isn't ready (bootstrap ordering); wmt-boot's postinst redeploys.
command -v mkimage >/dev/null 2>&1 || exit 0

# Target kernel: the one passed in, else the newest installed image (by build time)
version=${1:-$(ls -t /boot/vmlinuz-* 2>/dev/null | head -n1 | sed 's#.*/vmlinuz-##')}
image="/boot/vmlinuz-$version"
[ -n "$version" ] && [ -f "$image" ] || exit 0

dtb=$(find "/usr/lib/linux-image-$version" -name 'wm8505-ref.dtb' 2>/dev/null | head -n1)
[ -n "$dtb" ] || exit 0

# Stage the new slot on the FAT itself, not in /tmp: on this RAM-starved device
# /tmp is a small tmpfs, and a kernel deploy must not depend on it having room.
# Staging at the destination also keeps the final swap an in-filesystem rename.
new="$boot/.script.new"
rm -rf "$new"
mkdir -p "$new"
# uzImage.bin: zImage with its DTB appended, wrapped as a U-Boot kernel image
cat "$image" "$dtb" > "$new/.payload"
mkimage -A arm -O linux -T kernel -C none -a 0x8000 -e 0x8000 -n linux \
	-d "$new/.payload" "$new/uzImage.bin" >/dev/null
# scriptcmd: the splash template with this kernel's release + build date prepended
build_time=$(date -ur "$image" +"%Y-%m-%d %H:%M:%S UTC")
sed "1i setenv KERNEL_RELEASE $version\nsetenv BUILD_TIME $build_time" "$template" > "$new/.payload"
mkimage -A arm -O linux -T script -C none -a 1 -e 0 -n "script image" \
	-d "$new/.payload" "$new/scriptcmd" >/dev/null
rm -f "$new/.payload"
printf '%s\n' "$version" > "$new/version"
sync

# Demote the active slot to rollback only if it holds a different, still-installed
# kernel, so a redeploy or active-kernel removal can't clobber a good rollback.
active=$(cat "$boot/script/version" 2>/dev/null || true)
if [ -d "$boot/script" ] && [ "$active" != "$version" ] && [ -f "/boot/vmlinuz-$active" ]; then
	rm -rf "$boot/script.bak"
	mv "$boot/script" "$boot/script.bak"
else
	rm -rf "$boot/script"
fi
mv "$new" "$boot/script"
# Drop the rollback slot if it now duplicates the active kernel.
if [ "$(cat "$boot/script.bak/version" 2>/dev/null)" = "$version" ]; then
	rm -rf "$boot/script.bak"
fi
sync
